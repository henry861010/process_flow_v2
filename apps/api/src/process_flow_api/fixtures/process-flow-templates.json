[
  {
    "schemaVersion": 2,
    "id": "flow_tpl_aaa_demo",
    "name": "AAA Demo",
    "version": "V0.0.0",
    "description": "Demo AAA style package flow with die placement, molding, RDL, and C4 bump formation.",
    "owner": "demo.example",
    "flowInputs": [
      {
        "flowInputId": "incoming_panel",
        "name": "Incoming panel",
        "description": "External geometry supplied by the process flow instance.",
        "dataType": "geometry",
        "required": true,
        "geometryConstraints": {
          "entityTypes": [
            "panel"
          ],
          "categories": [
            "carrier.panel"
          ],
          "structureFormats": [
            "standard"
          ]
        }
      },
      {
        "flowInputId": "incoming_hbm",
        "name": "Incoming HBM",
        "description": "External geometry supplied by the process flow instance.",
        "dataType": "geometry",
        "required": true,
        "geometryConstraints": {
          "entityTypes": [
            "die"
          ],
          "categories": [
            "die.hbm"
          ],
          "structureFormats": [
            "standard"
          ]
        }
      }
    ],
    "stepRefs": [
      {
        "stepRefId": "pnp_hbm",
        "stepLabel": "PnP",
        "processStepTemplateId": "step_tpl_pnp",
        "parameterDefaults": {}
      },
      {
        "stepRefId": "mold_cap",
        "stepLabel": "molding",
        "processStepTemplateId": "step_tpl_molding",
        "parameterDefaults": {
          "material": "EMC-G700",
          "thickness": 180
        }
      },
      {
        "stepRefId": "rdl_build",
        "stepLabel": "RDL layer",
        "processStepTemplateId": "step_tpl_rdl",
        "parameterDefaults": {}
      },
      {
        "stepRefId": "c4_bump",
        "stepLabel": "C4 Bump",
        "processStepTemplateId": "step_tpl_c4_bump_formation",
        "parameterDefaults": {
          "material": "SAC305",
          "thk": 65,
          "density": 58,
          "koz": 18
        }
      }
    ],
    "flowEdges": [
      {
        "edgeId": "edge_aaa_panel_to_pnp_main",
        "source": {
          "kind": "flowInput",
          "flowInputId": "incoming_panel"
        },
        "target": {
          "stepRefId": "pnp_hbm",
          "inputPortId": "main_geometry"
        }
      },
      {
        "edgeId": "edge_aaa_hbm_to_pnp_die",
        "source": {
          "kind": "flowInput",
          "flowInputId": "incoming_hbm"
        },
        "target": {
          "stepRefId": "pnp_hbm",
          "inputPortId": "die_geometry"
        }
      },
      {
        "edgeId": "edge_aaa_pnp_to_mold",
        "source": {
          "kind": "stepOutput",
          "stepRefId": "pnp_hbm",
          "outputPortId": "result_geometry"
        },
        "target": {
          "stepRefId": "mold_cap",
          "inputPortId": "main_geometry"
        }
      },
      {
        "edgeId": "edge_aaa_mold_to_rdl",
        "source": {
          "kind": "stepOutput",
          "stepRefId": "mold_cap",
          "outputPortId": "result_geometry"
        },
        "target": {
          "stepRefId": "rdl_build",
          "inputPortId": "main_geometry"
        }
      },
      {
        "edgeId": "edge_aaa_rdl_to_c4",
        "source": {
          "kind": "stepOutput",
          "stepRefId": "rdl_build",
          "outputPortId": "result_geometry"
        },
        "target": {
          "stepRefId": "c4_bump",
          "inputPortId": "main_geometry"
        }
      }
    ]
  }
]
